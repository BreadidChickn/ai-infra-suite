# AI Infra Terminal configuration. Copy to `.env` (git-ignored) and fill in YOUR values.
# Both servers (server.mjs and serve.py) and the build script read this file; real environment
# variables override it. Never commit `.env`. When setting up with Grok Bot, supply secrets through
# Grok Bot's secure secret entry instead of pasting them into chat.

# Port and bind address. 127.0.0.1 = this computer only (safest).
# Use HOST=0.0.0.0 to reach it from other devices on your network; then BOT_TOKEN is required for bot writes.
PORT=4173
HOST=127.0.0.1

# Required by SEC EDGAR fair-access policy: identify yourself with a real contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="AI-Infra-Terminal/1.0 your-email@example.com"

# Shared secret the trading bot sends as `Authorization: Bearer <token>` on POST /api/bot/*.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_TOKEN=

# Optional: forward "add company" requests from Search to a Grok Bot listener.
# If unset, grokbot-webhook.json (see grokbot-webhook.example.json) is used when present.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_AUTH=
