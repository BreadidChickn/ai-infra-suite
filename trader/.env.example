# Copy to .env and fill in. Never commit .env.
# Names match the AI Infra Terminal contract (BOT_TOKEN) and this bot's publisher (BOT_API_URL).

# Terminal API (default: local serve.py / server.mjs)
BOT_API_URL=http://127.0.0.1:4173
# Shared write token. If unset and the terminal has no bot-token.json, only loopback may POST.
# Same name as the terminal: env BOT_TOKEN (or bot-token.json {"token":"…"} next to the server).
BOT_TOKEN=

# Alpaca paper trading (never paste keys into chat)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Strategy tunables (optional)
TRADING_PERIOD=7d
STOP_DRAWDOWN=0.25
TARGET_RETURN=0.29
# SEC_JSON=   # optional override; defaults to aitrader/data/sec-financials.json

# Orders are always blocked unless BOTH are set (default = dry-run only)
# DRY_RUN=false
# ALLOW_ORDERS=1

# ----------------------------------------------------------------------------------------------
# REAL-MONEY TRADING (opt-in, at your own risk) — read DISCLAIMER.md first. Leave commented for paper.
# Live needs ALL of: TRADING_MODE=live, DRY_RUN=false, ALLOW_ORDERS=1, the exact LIVE_RISK_ACK phrase,
# and SEPARATE live keys (never reuse the paper keys above). Endpoint: https://api.alpaca.markets
# TRADING_MODE=paper
# ALPACA_LIVE_API_KEY_ID=
# ALPACA_LIVE_API_SECRET_KEY=
# LIVE_RISK_ACK=I ACCEPT FULL RISK OF LOSS
# LIVE_SLEEVE=B                 # only this sleeve trades real money
# LIVE_MAX_CAPITAL=100          # USD cap across ALL sleeves
# LIVE_MAX_ORDER_USD=50         # per-order notional cap
# LIVE_DAILY_LOSS_LIMIT=0.05    # halt + close all if account is down 5% on the day
# LIVE_STOP_DRAWDOWN=0.25       # halt + close all at 25% below peak (defaults to STOP_DRAWDOWN)
# TRADING_HALT=1                # kill switch (or create state/KILL)
